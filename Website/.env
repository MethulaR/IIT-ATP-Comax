# Public config. Safe to commit. Override per environment in .env.local or your host's settings.
# Where every "Request a demo" button points. Change to the live CoMax portal later.
VITE_PORTAL_URL=#contact
# Canonical site origin, used for canonical, Open Graph, robots.txt and sitemap.xml
VITE_SITE_URL=https://comaxdigital.com
# Optional: an endpoint that accepts the contact form as JSON (Formspree, Basin, your API).
# Leave empty to run the form in demo mode.
VITE_FORM_ENDPOINT=
